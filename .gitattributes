# Normalize line endings for all text files
* text=auto

# Explicitly set line endings for source files
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.c text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.py text eol=lf

# Binary files
*.so binary
*.a binary
*.lib binary
*.dll binary
*.exe binary
*.idx binary

